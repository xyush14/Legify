# Secrets — never commit
.env
.env.*
!.env.example

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.egg-info/
.venv/
venv/
env/

# Local data
feedback.db
feedback.db-journal
*.sqlite
*.sqlite3
*.sqlite-wal
*.sqlite-shm
# Compressed corpus artifacts (the shippable full DB, built by
# scripts/build_shippable_corpus.py and uploaded to a host — never committed).
*.sqlite.gz
*.sqlite.zst
# EXCEPTION: the ~14MB core judgments DB (sc_judgments metadata + sc_tar_offsets,
# NO extracted text) is tracked + baked into the Docker image so the app can
# seed /data/judgments.sqlite on first boot. Rebuild it with:
#   python scripts/build_judgments_core.py --force
!judgments_core.sqlite
kanoon_cache/
.cache/

# Notion sync — local marker for scripts/notion_sync.py (last commit mirrored to Notion)
.notion_sync_state.json

# IDE / tooling
.vscode/
.idea/
.claude/
*.swp
.DS_Store

# Logs
*.log

# Courtbook competitive-research corpus — third-party content scraped from
# courtbook.in for roadmap analysis only (scripts/scrape_courtbook.py). Raw HTML
# cache + parsed JSONL + xlsx/md reports. NEVER committed, served, or rehosted.
.courtbook_cache/
research/courtbook/

# Reference templates — real client filings, scrubbed or unscrubbed,
# used to tune format_specs in headnote/drafter/compose_templates.py.
# Never committed — client names, FIR numbers, addresses must not leak
# into version control. The README in the folder is committed; everything
# else is local-only.
templates_reference/*
!templates_reference/README.md
_build/

# Exported user PII (Supabase snapshot) — never commit
headnote_contacts.csv

# Regional-language runtime write-back cache (machine translations, not verified)
headnote/drafter/i18n/machine/

# Pytest cache
.pytest_cache/
.mcp.json
Demo_Users_Followup.csv
.preview_tmp/
.agents/
.codex/

# Working artefacts, not source. intake_files/ holds captured DNA spines and
# skeletons derived from a real advocate's filed drafts; design-proof/ and the
# root-level PDFs/DOCX are generated collateral. None of it is read at runtime.
intake_files/
design-proof/
/*.pdf
/*.docx
/*.xlsx

# THIS REPOSITORY IS PUBLIC on GitHub. Everything below is real-world material
# that must never be published, for the same reason intake_files/ is ignored
# above — it is other people's information, or ours but private:
#
#   ocr-bakeoff/   verbatim OCR of a real police gang-chart and charge-sheet.
#                  Named accused, their fathers' names, villages, police
#                  stations, FIR numbers. Publishing it would put identified
#                  criminal-case parties on the open internet.
#   campus-sales/  named placement officers with their direct phone numbers
#                  and college email addresses.
#   fundraise/     the investor target list, angel shortlist, sizing and the
#                  pitch deck. Ours, but not for competitors to read.
#   PERSONAL_ASSIST_CONTEXT.md
#                  real advocates' personal email addresses.
#
# Keep these in the folder, out of git. If any of it ever needs versioning,
# make the repository private FIRST — a public commit cannot be un-published.
docs/ocr-bakeoff/
docs/campus-sales/
docs/fundraise/
docs/PERSONAL_ASSIST_CONTEXT.md
